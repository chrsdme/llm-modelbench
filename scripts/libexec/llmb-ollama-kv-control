#!/usr/bin/python3 -I
"""Root-owned, semantic broker for temporary Ollama KV repair.

Only this standard-library program performs privileged service work.  It has
no project imports, does not use caller PATH/environment, and accepts no unit,
path, fragment, executable, or command argument.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import re
import secrets
import stat
import subprocess
import sys
from pathlib import Path
from typing import Any

PROTOCOL_VERSION = 1
STATE_ROOT = Path("/var/lib/llm-modelbench/kv-repair")
SYSTEMD_ROOT = Path("/etc/systemd/system")
SS = "/usr/bin/ss"
SYSTEMCTL = "/usr/bin/systemctl"
SAFE_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C", "LC_ALL": "C"}
MANAGED_NAME = "zzzz-llmb-repair-kv.conf"
MARKER = "# Managed by llmb-ollama-kv-control; restore through this broker.\n"
KV_VALUES = {"q4_0", "q8_0"}
TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]{32,128}$")
UNIT_RE = re.compile(r"^[A-Za-z0-9_.@-]+\.service$")


class BrokerError(RuntimeError):
    def __init__(self, message: str, code: str = "operation_failed") -> None:
        super().__init__(message); self.code = code


def _port(value: str) -> int:
    if not value.isascii() or not value.isdecimal(): raise argparse.ArgumentTypeError("port must be decimal")
    port = int(value)
    if not 1 <= port <= 65535: raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port


def _sha(data: bytes) -> str: return hashlib.sha256(data).hexdigest()


def _check_dir(path: Path, mode: int, *, create: bool = False) -> None:
    if create and not path.exists():
        path.mkdir(parents=True, mode=mode)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != mode:
        raise BrokerError(f"unsafe trusted directory: {path}", "unsafe_filesystem")


def _state_dir() -> None:
    _check_dir(STATE_ROOT, 0o700, create=True)


def _state_path(token: str) -> Path:
    if not TOKEN_RE.fullmatch(token): raise BrokerError("invalid transaction token", "invalid_transaction")
    return STATE_ROOT / f"{token}.json"


def _write_bytes_atomic(path: Path, data: bytes, mode: int) -> None:
    _check_dir(path.parent, 0o755)
    tmp = path.parent / ("." + secrets.token_urlsafe(24))
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(tmp, flags, mode)
    try:
        os.write(fd, data); os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, path); os.chmod(path, mode)
    finally:
        try: tmp.unlink()
        except FileNotFoundError: pass


def _write_state(token: str, state: dict[str, Any]) -> None:
    _state_dir(); target = _state_path(token)
    # state root is 0700; reuse a root-owned 0755-compatible helper only after
    # a dedicated secure atomic write implementation for the private directory.
    tmp = STATE_ROOT / ("." + secrets.token_urlsafe(24))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        raw = (json.dumps(state, sort_keys=True) + "\n").encode(); os.write(fd, raw); os.fsync(fd)
    finally: os.close(fd)
    try: os.replace(tmp, target); os.chmod(target, 0o600)
    finally:
        try: tmp.unlink()
        except FileNotFoundError: pass


def _read_state(token: str) -> dict[str, Any]:
    _state_dir(); path = _state_path(token)
    try: info = path.lstat()
    except FileNotFoundError as exc: raise BrokerError("unknown transaction", "unknown_transaction") from exc
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
        raise BrokerError("transaction state is not root-private", "unsafe_filesystem")
    try: return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc: raise BrokerError("invalid transaction state", "invalid_state") from exc


def _caller() -> dict[str, str]:
    uid, user = os.environ.get("SUDO_UID"), os.environ.get("SUDO_USER")
    if uid is None and user is None:
        if os.geteuid() != 0: raise BrokerError("broker must run as root", "not_root")
        return {"uid": "root", "user": "root", "direct_root": "true"}
    if uid is None or user is None or not uid.isdecimal() or not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", user):
        raise BrokerError("invalid sudo identity", "invalid_owner")
    return {"uid": uid, "user": user, "direct_root": "false"}


def _run(argv: list[str], *, check: bool = True, timeout: int = 120) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(argv, text=True, capture_output=True, check=False, timeout=timeout, env=SAFE_ENV)
    if check and result.returncode: raise BrokerError("trusted system operation failed", "system_operation_failed")
    return result


def _listener_pid(port: int) -> int:
    matches: set[int] = set()
    for line in _run([SS, "-H", "-tlnp"], timeout=15).stdout.splitlines():
        fields = line.split()
        if len(fields) >= 5 and (fields[3].endswith(f":{port}") or fields[3].endswith(f"]:{port}")):
            match = re.search(r"pid=(\d+)", line)
            if match: matches.add(int(match.group(1)))
    if len(matches) != 1: raise BrokerError("Ollama listener ownership is absent or ambiguous", "listener_ambiguous")
    return matches.pop()


def _unit_for_listener(port: int) -> tuple[str, int]:
    pid = _listener_pid(port)
    try:
        comm = Path(f"/proc/{pid}/comm").read_text(errors="replace").lower()
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().lower()
    except OSError as exc: raise BrokerError("cannot inspect listener identity", "listener_identity") from exc
    if b"ollama" not in cmdline and "ollama" not in comm: raise BrokerError("listener process is not Ollama", "not_ollama")
    candidates = []
    for line in _run([SYSTEMCTL, "list-units", "--type=service", "--all", "--no-legend", "--plain"], timeout=15).stdout.splitlines():
        unit = line.strip().lstrip("●").strip().split(maxsplit=1)[0] if line.strip() else ""
        if UNIT_RE.fullmatch(unit) and "ollama" in unit.lower():
            main = _run([SYSTEMCTL, "show", unit, "--property=MainPID", "--value"], timeout=15).stdout.strip()
            if main.isdecimal() and int(main) == pid: candidates.append(unit)
    if len(candidates) != 1: raise BrokerError("Ollama systemd ownership is absent or ambiguous", "service_ambiguous")
    return candidates[0], pid


def _revalidate(state: dict[str, Any]) -> tuple[str, int]:
    unit, pid = _unit_for_listener(int(state["port"]))
    if unit != state["unit"]: raise BrokerError("Ollama service ownership changed", "stale_service")
    return unit, pid


def _dropin(unit: str) -> Path:
    if not UNIT_RE.fullmatch(unit): raise BrokerError("invalid managed service", "invalid_state")
    return SYSTEMD_ROOT / f"{unit}.d" / MANAGED_NAME


def _service_dir(unit: str, *, create: bool = False) -> Path:
    _check_dir(SYSTEMD_ROOT, 0o755)
    path = _dropin(unit).parent
    if create and not path.exists(): path.mkdir(mode=0o755)
    _check_dir(path, 0o755)
    return path


def _existing(path: Path) -> bytes | None:
    try: info = path.lstat()
    except FileNotFoundError: return None
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o644:
        raise BrokerError("managed drop-in collision is unsafe", "unsafe_filesystem")
    data = path.read_bytes()
    if not data.startswith(MARKER.encode()): raise BrokerError("refusing unmanaged managed-drop-in collision", "unmanaged_collision")
    return data


def _content(kv: str) -> bytes:
    if kv not in KV_VALUES: raise BrokerError("KV must be exactly q4_0 or q8_0", "invalid_kv")
    return (MARKER + "[Service]\n" + f'Environment="OLLAMA_KV_CACHE_TYPE={kv}"\n').encode()


def _assert_hash(state: dict[str, Any]) -> None:
    now = _existing(_dropin(state["unit"]))
    expected = state.get("last_hash")
    if (None if now is None else _sha(now)) != expected: raise BrokerError("managed drop-in changed outside this transaction", "external_modification")


def _apply_file(state: dict[str, Any], data: bytes | None) -> None:
    path = _dropin(state["unit"]); _service_dir(state["unit"], create=data is not None); _assert_hash(state)
    if data is None:
        try: path.unlink()
        except FileNotFoundError: pass
    else:
        _write_bytes_atomic(path, data, 0o644)
    state["last_hash"] = None if data is None else _sha(data)


def _observed(state: dict[str, Any], pid: int | None = None) -> tuple[str | None, str | None]:
    unit = state["unit"]
    env = _run([SYSTEMCTL, "show", unit, "--property=Environment", "--value"], timeout=15).stdout
    match = re.search(r"(?:^|\s)OLLAMA_KV_CACHE_TYPE=([^\s\"']+)", env)
    merged = match.group(1).lower() if match else None
    if pid is None: _, pid = _revalidate(state)
    live = None
    for entry in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"):
        if entry.startswith(b"OLLAMA_KV_CACHE_TYPE="):
            live = entry.split(b"=", 1)[1].decode("utf-8", "replace").lower(); break
    return merged, live


def _restart_verify(state: dict[str, Any], expected: str) -> str:
    _run([SYSTEMCTL, "daemon-reload"], timeout=60)
    merged, _ = _observed(state)
    if merged != expected: raise BrokerError("merged systemd environment did not contain requested KV", "merged_verification_failed")
    _run([SYSTEMCTL, "restart", state["unit"]], timeout=120)
    if _run([SYSTEMCTL, "is-active", "--quiet", state["unit"]], check=False, timeout=15).returncode != 0:
        raise BrokerError("Ollama service did not become active", "service_inactive")
    _, pid = _revalidate(state); _, live = _observed(state, pid)
    if live != expected: raise BrokerError("live Ollama process KV verification failed", "live_verification_failed")
    return live


def _owner(state: dict[str, Any]) -> None:
    if state.get("owner") != _caller(): raise BrokerError("transaction belongs to another sudo identity", "owner_mismatch")


def _lock_path(unit: str) -> Path: return STATE_ROOT / ("service-" + _sha(unit.encode()) + ".lock")


def _begin(port: int) -> dict[str, Any]:
    _state_dir(); unit, pid = _unit_for_listener(port); lock = _lock_path(unit)
    try: fd = os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    except FileExistsError as exc: raise BrokerError("another KV repair transaction requires recovery", "transaction_locked") from exc
    token = secrets.token_urlsafe(32)
    try:
        os.write(fd, token.encode()); os.fsync(fd)
    finally: os.close(fd)
    try:
        original = _existing(_dropin(unit))
        state = {"protocol": PROTOCOL_VERSION, "token": token, "port": port, "unit": unit, "listener_pid": pid,
                 "owner": _caller(), "state": "active", "original": None if original is None else base64.b64encode(original).decode(),
                 "original_hash": None if original is None else _sha(original), "last_hash": None if original is None else _sha(original), "current_kv": None}
        _write_state(token, state)
    except BaseException:
        lock.unlink(missing_ok=True); raise
    return _reply("begin", state, transaction=token)


def _rollback(token: str, state: dict[str, Any]) -> None:
    state["state"] = "restoring"; _write_state(token, state)
    try:
        original = None if state["original"] is None else base64.b64decode(state["original"])
        _apply_file(state, original); _run([SYSTEMCTL, "daemon-reload"], timeout=60); _run([SYSTEMCTL, "restart", state["unit"]], timeout=120)
        _revalidate(state); state["state"] = "restored"; _write_state(token, state)
    except BaseException:
        state["state"] = "rollback_failed"; _write_state(token, state); raise BrokerError("operation failed and rollback failed", "rollback_failed")


def _set(token: str, kv: str) -> dict[str, Any]:
    state = _read_state(token); _owner(state); _revalidate(state); _assert_hash(state)
    state["state"] = "applying"; _write_state(token, state)
    try:
        _apply_file(state, _content(kv)); observed = _restart_verify(state, kv)
    except BaseException:
        state["state"] = "failed"; _write_state(token, state); _rollback(token, state); raise
    state.update({"state": "applied", "current_kv": kv}); _write_state(token, state)
    return _reply("set", state, transaction=token, verified=True, observed_kv=observed)


def _restore(token: str) -> dict[str, Any]:
    state = _read_state(token); _owner(state); _revalidate(state); _assert_hash(state); _rollback(token, state)
    if state["state"] != "restored": raise BrokerError("restore did not complete", "rollback_failed")
    _state_path(token).unlink(); _lock_path(state["unit"]).unlink(missing_ok=True)
    return _reply("restore", state, transaction=token, restored=True)


def _status(token: str) -> dict[str, Any]:
    state = _read_state(token); _owner(state); _, pid = _revalidate(state); _assert_hash(state)
    merged, live = _observed(state, pid)
    return _reply("status", state, transaction=token, observed_kv=live, merged_kv=merged)


def _reply(operation: str, state: dict[str, Any] | None = None, **extra: Any) -> dict[str, Any]:
    result = {"protocol": PROTOCOL_VERSION, "ok": True, "operation": operation, "transaction": None, "state": None, "unit": None, "kv": None, "observed_kv": None, "error_code": None, "message": ""}
    if state: result.update({"state": state.get("state"), "unit": state.get("unit"), "kv": state.get("current_kv")})
    result.update(extra); return result


def dispatch(args: argparse.Namespace) -> dict[str, Any]:
    if args.command == "version": return _reply("version")
    if args.command == "probe":
        unit, _ = _unit_for_listener(args.port); return _reply("probe", {"unit": unit})
    if args.command == "begin": return _begin(args.port)
    if args.command == "set": return _set(args.transaction, args.kv)
    if args.command == "status": return _status(args.transaction)
    if args.command == "restore": return _restore(args.transaction)
    raise BrokerError("unknown operation", "invalid_operation")


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__); sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("version")
    for name in ("probe", "begin"):
        q = sub.add_parser(name); q.add_argument("--port", required=True, type=_port)
    q = sub.add_parser("set"); q.add_argument("--transaction", required=True); q.add_argument("--kv", required=True, choices=sorted(KV_VALUES))
    for name in ("status", "restore"):
        q = sub.add_parser(name); q.add_argument("--transaction", required=True)
    return p


def main() -> int:
    args = parser().parse_args()
    try: payload = dispatch(args)
    except (BrokerError, OSError, subprocess.SubprocessError) as exc:
        payload = _reply(getattr(args, "command", "unknown")); payload.update({"ok": False, "error_code": getattr(exc, "code", "operation_failed"), "message": str(exc)})
        print(json.dumps(payload, sort_keys=True)); return 1
    print(json.dumps(payload, sort_keys=True)); return 0


if __name__ == "__main__": raise SystemExit(main())
